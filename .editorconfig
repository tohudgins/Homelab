# https://editorconfig.org — consistent whitespace across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{ps1,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false  # trailing spaces are meaningful (hard line breaks)

[Makefile]
indent_style = tab
