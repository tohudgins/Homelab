<!--
  - Allowed static fields:
  - location   - where the log came from (only on FTS)
  - srcuser    - extracts the source username
  - dstuser    - extracts the destination (target) username
  - user       - an alias to dstuser (only one of the two can be used)
  - srcip      - source ip
  - dstip      - dst ip
  - srcport    - source port
  - dstport    - destination port
  - protocol   - protocol
  - id         - event id
  - url        - url of the event
  - action     - event action (deny, drop, accept, etc)
  - status     - event status (success, failure, etc)
  - extra_data - Any extra data
-->

<decoder name="local_decoder_example">
    <program_name>local_decoder_example</program_name>
</decoder>

<decoder name="samba-full-audit">
  <parent>smbd</parent>
  <regex type="pcre2">(\S+)\|([\d.]+)\|(\S+)\|(\S+)\|(\w+)\|(\w+)\|(\w+)\|(\S+)$</regex>
  <order>smb_user,srcip,smb_machine,smb_share,smb_op,smb_result,smb_mode,smb_path</order>
</decoder>

<!--
  NOTE (2026-08-24): a child decoder chained onto the built-in `json` decoder to
  pull a bare srcip out of "KDC Authorization".remoteAddress ("ipv4:10.10.40.119:57860")
  was tried and rejected: a regex child of the json decoder REPLACES the parent's
  accumulated field set with only its own <order> field, stripping `type` and the
  "KDC Authorization" object, which breaks rule 100030's field match. So Kerberoast
  correlation stays keyed on `KDC Authorization.account` (see rule 100031) rather
  than source IP. Documented so the dead end isn't re-attempted.
-->


<!--
  MISP integration: custom-misp.py injects `1:misp:{"integration": "misp", ...}`.
  No custom decoder needed — Wazuh's built-in `json` decoder flattens it into
  integration / misp.value / misp.source.* fields, which rules 100300+ match on
  (decoded_as json). A custom decoded_as would only shadow the json decoder and
  break the field match (learned by exercising, 2026-08-30).
-->


<!--
  YARA-on-FIM: yara.sh (fs-01 active response) writes match lines to
  active-responses.log, e.g.
      2026/09/06 13:20:00 wazuh-yara: INFO - Scan result: EICAR_Test_File /srv/samba/public/x
  The parent decoder anchors on the `wazuh-yara:` prefix; the child pulls the
  matched rule name + scanned file into fields for rule 100460.
-->
<decoder name="wazuh-yara">
  <prematch>wazuh-yara:</prematch>
</decoder>

<decoder name="wazuh-yara-result">
  <parent>wazuh-yara</parent>
  <regex>Scan result: (\S+) (\S+)</regex>
  <order>yara_rule, yara_scanned_file</order>
</decoder>


<!--
  disable-ad-account AR completion: disable-ad-account.py (dc-01, rule 100041's
  active response) writes a line to active-responses.log on every invocation, e.g.
      2026-09-20T14:03:11.123456+00:00 disable-ad-account: disable jdoe: rc=0 ...
  Same log-line -> localfile -> decoder -> rule idiom as wazuh-yara above, so the
  AR's own outcome becomes a real Wazuh alert instead of a silent log line — the
  piece the soc-ops playbook (custom-iris.py, see phase-4-detection/soc-ops-iris.md)
  needs to merge "contained" into the same IRIS case as the detection that
  triggered it. Only "disable"/"enable rc=<n>" lines match the child regex; the
  refuse-protected-account / no-account-found lines match the parent (still
  logged, just not alert-worthy for the case playbook) but not the child.
-->
<!-- program_name, not prematch: unlike wazuh-yara's non-standard "YYYY/MM/DD
     HH:MM:SS" date (which Wazuh's syslog predecoder doesn't recognize, so the
     raw line passes through untouched for <prematch> to search), this script's
     ISO8601 timestamp (isoformat(), including the UTC offset) IS recognized —
     the predecoder extracts it as `timestamp` and consumes the next colon-
     terminated token as `program_name`, stripping "disable-ad-account:" out
     of the text before <prematch> would ever see it. Confirmed live via
     wazuh-logtest 2026-09-20: the prematch form produced "No decoder matched"
     even though the literal substring is right there in full_log. Matching
     on program_name instead uses the field Wazuh already extracts, rather
     than fighting its own predecoder. -->
<decoder name="disable-ad-account">
  <program_name>disable-ad-account</program_name>
</decoder>

<decoder name="disable-ad-account-result">
  <parent>disable-ad-account</parent>
  <!-- Wazuh's plain <regex> is OSRegex, not PCRE — no (a|b) alternation
       support (that needs an explicit type="pcre2", unused elsewhere in this
       file). \w+ captures "disable" or "enable" generically instead —
       verified live 2026-09-20 after the alternation form failed analysisd's
       config parse with "Syntax error on regex". Matches against the message
       remaining after program_name is stripped, e.g. " disable jdoe: rc=0". -->
  <regex>(\w+) (\S+): rc=(\d+)</regex>
  <order>ar_action, ar_account, ar_rc</order>
</decoder>

<!--
  DMZ web attack, host-side layer (gap-10 fix, 2026-09-30): Juice Shop itself
  logs zero per-request lines to stdout (confirmed live — real attack requests
  produced no new container-log output), so an nginx reverse proxy was put in
  front of it (roles/dmz) purely to get a real, independent host-side access
  log — the same traffic rtr-01's inline Suricata already sees on the wire
  (sids 9100020-9100024 / Wazuh rules 100440-100442), now also visible from
  the host's own log, e.g.:
      JSWEB_JUICESHOP time="30/Sep/2026:02:30:00 +0000" srcip=10.10.40.119 method=GET uri="/rest/products/search?q=test%27%20OR%201=1[dash-dash]" proto=HTTP/1.1 status=500 body="-" ua="curl/8.5.0"
  key=value shape, not combined/common log format, is deliberate: a
  combined-log-shaped line (IP - [time] "REQUEST" status ...) was tried first
  and collided with Wazuh's own stock `web-accesslog` decoder, which matched
  it and fired the generic rule 31122 instead of this one — confirmed via
  wazuh-logtest, even with a leading "JSWEB " marker token. This shape doesn't
  resemble any stock decoder Wazuh ships, so it can't be shadowed the same way.
-->
<decoder name="juiceshop-nginx">
  <prematch>^JSWEB_JUICESHOP </prematch>
</decoder>

<decoder name="juiceshop-nginx-fields">
  <parent>juiceshop-nginx</parent>
  <regex type="pcre2">^JSWEB_JUICESHOP time="[^"]+" srcip=(\S+) method=(\S+) uri="(.*?)" proto=\S+ status=(\d+) body="(.*?)" ua="(.*)"$</regex>
  <order>srcip, http_method, http_uri, status, request_body, user_agent</order>
</decoder>

