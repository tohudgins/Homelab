<!--
  - Allowed static fields:
  - location   - where the log came from (only on FTS)
  - srcuser    - extracts the source username
  - dstuser    - extracts the destination (target) username
  - user       - an alias to dstuser (only one of the two can be used)
  - srcip      - source ip
  - dstip      - dst ip
  - srcport    - source port
  - dstport    - destination port
  - protocol   - protocol
  - id         - event id
  - url        - url of the event
  - action     - event action (deny, drop, accept, etc)
  - status     - event status (success, failure, etc)
  - extra_data - Any extra data
-->

<decoder name="local_decoder_example">
    <program_name>local_decoder_example</program_name>
</decoder>

<decoder name="samba-full-audit">
  <parent>smbd</parent>
  <regex type="pcre2">(\S+)\|([\d.]+)\|(\S+)\|(\S+)\|(\w+)\|(\w+)\|(\w+)\|(\S+)$</regex>
  <order>smb_user,srcip,smb_machine,smb_share,smb_op,smb_result,smb_mode,smb_path</order>
</decoder>

<!--
  NOTE (2026-08-24): a child decoder chained onto the built-in `json` decoder to
  pull a bare srcip out of "KDC Authorization".remoteAddress ("ipv4:10.10.40.119:57860")
  was tried and rejected: a regex child of the json decoder REPLACES the parent's
  accumulated field set with only its own <order> field, stripping `type` and the
  "KDC Authorization" object, which breaks rule 100030's field match. So Kerberoast
  correlation stays keyed on `KDC Authorization.account` (see rule 100031) rather
  than source IP. Documented so the dead end isn't re-attempted.
-->


<!--
  MISP integration: custom-misp.py injects `1:misp:{"integration": "misp", ...}`.
  No custom decoder needed — Wazuh's built-in `json` decoder flattens it into
  integration / misp.value / misp.source.* fields, which rules 100300+ match on
  (decoded_as json). A custom decoded_as would only shadow the json decoder and
  break the field match (learned by exercising, 2026-08-30).
-->


<!--
  YARA-on-FIM: yara.sh (fs-01 active response) writes match lines to
  active-responses.log, e.g.
      2026/09/06 13:20:00 wazuh-yara: INFO - Scan result: EICAR_Test_File /srv/samba/public/x
  The parent decoder anchors on the `wazuh-yara:` prefix; the child pulls the
  matched rule name + scanned file into fields for rule 100460.
-->
<decoder name="wazuh-yara">
  <prematch>wazuh-yara:</prematch>
</decoder>

<decoder name="wazuh-yara-result">
  <parent>wazuh-yara</parent>
  <regex>Scan result: (\S+) (\S+)</regex>
  <order>yara_rule, yara_scanned_file</order>
</decoder>

